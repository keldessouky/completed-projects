{
  "name": "meccha-chameleon-lan",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LAN multiplayer browser remake of MECCHA CHAMELEON — paint your chameleon to hide, hunt the hiders.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "npm run build && tsx server/index.ts",
    "server": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test:sim": "tsx scripts/sim.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
