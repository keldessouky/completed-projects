{
  "name": "comfyui-prompt-generator",
  "version": "0.1.0",
  "description": "Convert plain-English paragraphs into optimized prompts for ComfyUI / Stable Diffusion. Runs entirely in the browser.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
