{
  "name": "crown-and-circuit",
  "private": true,
  "version": "1.0.0",
  "description": "Free-roam hero auto-battler: haul coins, raise a fort, and hold the line from swords to lasers. PixiJS 8 + Howler + tween.js.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "node tools/build-single.mjs",
    "preview": "vite preview",
    "gen:audio": "node tools/gen-audio.mjs",
    "smoke": "node tools/smoke.mjs",
    "smoke:single": "node tools/smoke.mjs --single",
    "balance": "node tools/balance.mjs",
    "sheet": "node tools/spritesheet.mjs",
    "lpc": "node tools/vendor-lpc.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.2.0",
    "@fontsource/inter": "^5.2.0",
    "@fontsource/orbitron": "^5.2.0",
    "@tweenjs/tween.js": "^25.0.0",
    "howler": "^2.2.4",
    "pixi.js": "^8.6.0"
  },
  "devDependencies": {
    "@types/howler": "^2.2.12",
    "playwright-core": "^1.49.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
