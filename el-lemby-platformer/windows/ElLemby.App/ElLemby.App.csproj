<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the project compile on macOS/Linux CI and dev boxes too. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>ElLemby.App</RootNamespace>
    <AssemblyName>ElLemby</AssemblyName>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ElLemby.Core\ElLemby.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same pixel art, sounds, and stage as the macOS build — one source
         of truth, generated by tools/*.py. -->
    <Content Include="..\..\Sources\ElLembyCore\Resources\**\*.*"
             Link="Resources\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
