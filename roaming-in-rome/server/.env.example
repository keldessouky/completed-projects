# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://rome:rome_dev_pw@localhost:5432/roaming_in_rome?schema=public"

# Secret used to sign JWTs. Generate a long random value, e.g. `openssl rand -base64 48`.
JWT_SECRET="change-me-to-a-long-random-secret"

# How long an issued token stays valid.
JWT_EXPIRES_IN="1h"

# Origin allowed to call the API (the web app). Used for CORS.
WEB_ORIGIN="http://localhost:5173"

# Port the API listens on.
PORT=3000
